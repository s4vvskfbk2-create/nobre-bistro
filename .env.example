# Supabase Configuration
# Get these from your Supabase project settings at https://app.supabase.com/project/[PROJECT_ID]/settings/api
VITE_SUPABASE_URL=https://[PROJECT_ID].supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGc...

# Backend Service Role Key (for Edge Functions and RLS bypass - NEVER expose in frontend)
# Only use in server-side environments (Edge Functions, backend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# Application Configuration
VITE_APP_NAME=Nobre Café
VITE_TIMEZONE=America/Sao_Paulo
VITE_CURRENCY=BRL

# Security: PINs and passwords are hashed server-side via Supabase RPC functions
# Never store plain-text credentials in the frontend or .env files
